# AgentOS — copy to .env and fill in. Never commit .env (RECIPE A2: secrets in env only).

# --- Control plane ---
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Single-operator personal access token. Bearer credential for the CLI, the web
# UI, and the runner worker. Generate: openssl rand -hex 32
AGENTOS_OPERATOR_TOKEN=

# Derives per-trigger webhook signing keys. Set this in production so rotating
# your login does not also rotate every webhook. Generate: openssl rand -hex 32
WEBHOOK_MASTER_SECRET=

# Public origin agents hand out as the webhook URL.
PUBLIC_URL=http://localhost:3001

# --- Postgres (packages/db) ---
DATABASE_URL=postgres://agentos:agentos@localhost:5433/agentos

# --- Redis (BullMQ queues + schedulers) ---
REDIS_URL=redis://localhost:6380

# --- Anthropic Managed Agents (cloud runner) ---
# Resolution order is ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN -> `ant auth login`
# profile. Leave unset to use an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Workspace slug used to build Console trace links for a session.
ANTHROPIC_WORKSPACE=default

# --- Object storage (Phase 2 filesystem; MinIO locally, Cloudflare R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=agentos
S3_ACCESS_KEY_ID=agentos
S3_SECRET_ACCESS_KEY=agentos123

# --- Secret backend (SPEC §4) ---
# Where a secret reference is resolved. `env` reads this process's environment
# and is the development driver: a `providerRef` is the name of a variable.
# `gcp` reads Google Secret Manager, where the value is encrypted at rest and
# the app database holds only the resource name — set this in production.
# Credentials come from the ambient Google auth (GOOGLE_APPLICATION_CREDENTIALS
# or the instance's service account); AgentOS never stores them.
SECRETS_PROVIDER=env
# Default project for a bare secret name. A reference that is already a full
# resource path (projects/p/secrets/s[/versions/v]) is used as written.
GCP_PROJECT_ID=

# --- Web Push (PWA inbox). Leave blank to disable push. ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@localhost

# --- GitHub App: connect a repo without storing a personal access token. ---
# Create the App once at github.com/settings/apps/new with
#   Contents: read & write   (clone, commit, push)
#   Metadata: read           (required by GitHub)
# Set its callback URL to <PUBLIC_URL>/github/setup, generate a private key,
# then fill these in. The operator afterwards presses Connect in the UI and
# picks the repositories on github.com — nothing is typed into AgentOS.
#
# GITHUB_APP_SLUG is the part of the App's URL, e.g. github.com/apps/<slug>.
# GITHUB_APP_PRIVATE_KEY is a *secret reference*, resolved by SECRETS_PROVIDER:
# under `env` it names another variable holding the PEM (newlines may be
# written as \n); under `gcp` it names a Secret Manager resource. The PEM is
# never stored in the app database.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=GITHUB_APP_PEM
GITHUB_APP_PEM=
# GitHub Enterprise Server only:
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_HTML_URL=https://github.example.com

# --- Local runner: the control plane's half. Blank = cloud only. ---
# Where the VM worker listens, and the shared secret it authenticates with.
# Generate: openssl rand -hex 32
LOCAL_RUNNER_URL=
LOCAL_RUNNER_TOKEN=

# --- Local runner: the worker's half (apps/local-runner) ---
#
# In development both halves run on this machine and read this one file. In
# production they do NOT: the worker runs on a VM of its own and gets ONLY the
# variables in this block. Never copy the rest of this file onto that machine —
# it has no business holding DATABASE_URL, the operator token, or your S3 keys.
# Read DEPLOY.md §6 before enabling this backend.
#
# Preferred credential. Mint it on the worker's machine with `claude setup-token`;
# it bills against a Claude subscription at a flat rate, which is the entire
# reason this backend exists. Without it the worker falls back to
# ANTHROPIC_API_KEY above and bills per token — measured at roughly ten times the
# cloud runner for the same task.
CLAUDE_CODE_OAUTH_TOKEN=
# Better on a real VPS: point at a 0600 file owned by the worker's own unix
# user. On Linux `/proc/<pid>/environ` exposes a process's environment to
# anything running as that user, and a file is not in that block.
# Takes precedence over the variable above. ANTHROPIC_API_KEY_FILE does the
# same for the metered fallback.
CLAUDE_CODE_OAUTH_TOKEN_FILE=
ANTHROPIC_API_KEY_FILE=
# Where the worker listens. LOCAL_RUNNER_URL above must point at it.
LOCAL_RUNNER_PORT=4600
# Session workspaces are created and deleted here.
LOCAL_RUNNER_WORK_ROOT=/tmp/agentos-local
# Hard ceiling on one run, enforced by the worker independently of the control
# plane — if the control plane crashes mid-run, nothing else stops Claude Code.
LOCAL_RUNNER_MAX_SESSION_MINUTES=120
# How long the worker keeps a workspace whose commits it could not push. They
# are moved aside rather than deleted, because they hold the only copy of that
# work — this is how long you have to recover one before the boot sweep removes
# it. 0 keeps them forever, at the cost of disk on an unwatched machine.
LOCAL_RUNNER_QUARANTINE_DAYS=14
# Ceiling on model requests one session may push through the worker's
# credential proxy. The agent SDK's own spend cap covers only the calls it
# makes; an agent with a shell can call the proxy directly, and this bounds it.
LOCAL_RUNNER_MAX_SESSION_REQUESTS=500
# Shared capacity for specialist sessions and local orchestration decisions.
# Requests queue when full; they do not silently spill to cloud.
LOCAL_RUNNER_MAX_CONCURRENCY=2
# Operator-visible worker identity and placement.
LOCAL_RUNNER_WORKER_ID=
LOCAL_RUNNER_VERSION=
LOCAL_RUNNER_LOCATION=local-computer
# Start healthy but not ready, accepting no new work.
LOCAL_RUNNER_DRAIN=
# Adds a per-session loopback proxy that opens only the environment's
# allow-listed hosts and points the child's HTTP_PROXY/HTTPS_PROXY at it. It
# holds every ordinary client (curl, git, node, pip) and is NOT a cage against
# an agent that opens its own socket — so it is a layer, not a permission: on
# its own it does not make a limited-network session acceptable.
LOCAL_RUNNER_EGRESS_MODE=
# The permission. Accepts limited-network sessions on your assertion that this
# machine is confined — a container network policy, or a host firewall scoped to
# this worker's unix user. Unset, those sessions are REFUSED; `auto` may use
# cloud, while explicit `local` fails without a cloud fallback.
LOCAL_RUNNER_ALLOW_UNENFORCED_NETWORK=
# --- Local runner: the Grok engine (SPEC §16) ---
# An agent whose model starts with `grok` runs on xAI's OpenAI-compatible API
# instead of Claude Code, in yolo mode: no approval prompts, a shell confined to
# the session workspace, and the same AgentOS tools answered by the control
# plane. Without a key those sessions fail loudly rather than silently running
# on Claude.
# A session carrying a spend cap is refused by this engine: xAI reports tokens
# rather than dollars, so the cap could not be honoured. Those run on the cloud.
GROK_API_KEY=
# Better: a 0600 file owned by the worker's user, so the key is never in this
# process's environment block. Takes precedence over GROK_API_KEY.
GROK_API_KEY_FILE=
LOCAL_RUNNER_GROK_BASE_URL=https://api.x.ai/v1

# --- Queue worker (runs in-process with the API) ---
# Set to 1 to start the API without it — useful to inspect the control plane
# without it picking up jobs and starting sessions.
AGENTOS_DISABLE_WORKER=

# --- Error reporting (RECIPE A8) ---
# Any Sentry-compatible DSN; GlitchTip is the self-hosted one this is written
# for. LEAVE BLANK and failures stay in the log and never leave this machine —
# that is the default. Set it and the jobs nobody watches (orphan sweep, vault
# cleanup, container destroy, queue jobs) report where you will actually see
# them. Reports are scrubbed before sending: credentials by pattern, and task
# text / agent prose dropped outright.
GLITCHTIP_DSN=
# Tags reports, so a staging stack does not look like production.
DEPLOY_ENV=development
# Optional build identifier, so a regression points at a deploy.
RELEASE=
