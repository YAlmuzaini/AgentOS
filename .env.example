# AgentOS — copy to .env and fill in. Never commit .env (RECIPE A2: secrets in env only).

# --- Control plane ---
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Single-operator personal access token. Bearer credential for the CLI, the web
# UI, and the runner worker. Generate: openssl rand -hex 32
AGENTOS_OPERATOR_TOKEN=

# Derives per-trigger webhook signing keys. Set this in production so rotating
# your login does not also rotate every webhook. Generate: openssl rand -hex 32
WEBHOOK_MASTER_SECRET=

# Public origin agents hand out as the webhook URL.
PUBLIC_URL=http://localhost:3001

# --- Postgres (packages/db) ---
DATABASE_URL=postgres://agentos:agentos@localhost:5433/agentos

# --- Redis (BullMQ queues + schedulers) ---
REDIS_URL=redis://localhost:6380

# --- Anthropic Managed Agents (cloud runner) ---
# Resolution order is ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN -> `ant auth login`
# profile. Leave unset to use an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Workspace slug used to build Console trace links for a session.
ANTHROPIC_WORKSPACE=default

# --- Object storage (Phase 2 filesystem; MinIO locally, Cloudflare R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=agentos
S3_ACCESS_KEY_ID=agentos
S3_SECRET_ACCESS_KEY=agentos123

# --- Web Push (PWA inbox). Leave blank to disable push. ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@localhost

# --- Local runner: the control plane's half. Blank = cloud only. ---
# Where the VM worker listens, and the shared secret it authenticates with.
# Generate: openssl rand -hex 32
LOCAL_RUNNER_URL=
LOCAL_RUNNER_TOKEN=

# --- Local runner: the worker's half (apps/local-runner) ---
#
# In development both halves run on this machine and read this one file. In
# production they do NOT: the worker runs on a VM of its own and gets ONLY the
# variables in this block. Never copy the rest of this file onto that machine —
# it has no business holding DATABASE_URL, the operator token, or your S3 keys.
# Read DEPLOY.md §6 before enabling this backend.
#
# Preferred credential. Mint it on the worker's machine with `claude setup-token`;
# it bills against a Claude subscription at a flat rate, which is the entire
# reason this backend exists. Without it the worker falls back to
# ANTHROPIC_API_KEY above and bills per token — measured at roughly ten times the
# cloud runner for the same task.
CLAUDE_CODE_OAUTH_TOKEN=
# Better on a real VPS: point at a 0600 file owned by the worker's own unix
# user. On Linux `/proc/<pid>/environ` exposes a process's environment to
# anything running as that user, and a file is not in that block.
# Takes precedence over the variable above. ANTHROPIC_API_KEY_FILE does the
# same for the metered fallback.
CLAUDE_CODE_OAUTH_TOKEN_FILE=
ANTHROPIC_API_KEY_FILE=
# Where the worker listens. LOCAL_RUNNER_URL above must point at it.
LOCAL_RUNNER_PORT=4600
# Session workspaces are created and deleted here.
LOCAL_RUNNER_WORK_ROOT=/tmp/agentos-local
# Hard ceiling on one run, enforced by the worker independently of the control
# plane — if the control plane crashes mid-run, nothing else stops Claude Code.
LOCAL_RUNNER_MAX_SESSION_MINUTES=120
# Ceiling on model requests one session may push through the worker's
# credential proxy. The agent SDK's own spend cap covers only the calls it
# makes; an agent with a shell can call the proxy directly, and this bounds it.
LOCAL_RUNNER_MAX_SESSION_REQUESTS=500
# The worker cannot enforce an egress firewall, so it REFUSES sessions that ask
# for a limited network and lets them fall back to the cloud runner. Set to 1
# only once you have a real firewall on that machine.
LOCAL_RUNNER_ALLOW_UNENFORCED_NETWORK=

# --- Queue worker (runs in-process with the API) ---
# Set to 1 to start the API without it — useful to inspect the control plane
# without it picking up jobs and starting sessions.
AGENTOS_DISABLE_WORKER=

# --- Error reporting (RECIPE A8) ---
# Any Sentry-compatible DSN; GlitchTip is the self-hosted one this is written
# for. LEAVE BLANK and failures stay in the log and never leave this machine —
# that is the default. Set it and the jobs nobody watches (orphan sweep, vault
# cleanup, container destroy, queue jobs) report where you will actually see
# them. Reports are scrubbed before sending: credentials by pattern, and task
# text / agent prose dropped outright.
GLITCHTIP_DSN=
# Tags reports, so a staging stack does not look like production.
DEPLOY_ENV=development
# Optional build identifier, so a regression points at a deploy.
RELEASE=
